FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/requirements.txt

COPY backend /app/backend
COPY model /app/model
COPY scripts /app/scripts
COPY webapp/backend /app/webapp/backend
COPY alembic.ini /app/alembic.ini
COPY data/companies.json /app/data/companies.json
COPY data/company_overrides.json /app/data/company_overrides.json
COPY data/company_tickers.json /app/data/company_tickers.json
COPY data/benchmarks /app/data/benchmarks

CMD ["python", "-m", "uvicorn", "webapp.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM node:20-alpine AS frontend-build

WORKDIR /src/webapp/frontend
COPY webapp/frontend/package*.json ./
RUN npm ci
COPY webapp/frontend ./
RUN npm run build

FROM runtime AS web

COPY webapp/frontend/index.html /app/webapp/frontend/index.html
COPY --from=frontend-build /src/webapp/frontend/dist /app/webapp/frontend/dist

CMD ["python", "-m", "uvicorn", "webapp.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
