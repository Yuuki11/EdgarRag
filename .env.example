# Copy to .env and fill in. The real .env is gitignored.

# SEC requires a User-Agent identifying who is hitting the API.
SEC_USER_AGENT="Your Name your@email.com"

# Local Ollama server hosting the FinEdgar model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=finedgar

# Where dense-retrieval indices live.
CHROMADB_PATH=./data/vector_index

# Postgres is required for the web app because auth, sessions, and chat
# history are durable. These values are used by docker/compose/db.yml.
# POSTGRES_PASSWORD and FINEDGAR_AUTH_SECRET are secrets; do not commit real
# values. Generate FINEDGAR_AUTH_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_USER=finedgar
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=finedgar
FINEDGAR_POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finedgar:change-me-local-password@localhost:5432/finedgar

# Authentication and session cookies.
# Local HTTP development should use cookie secure = 0. Public deployments behind
# HTTPS should use 1, which is the Compose inference default.
FINEDGAR_AUTH_SECRET=change-me-generate-a-long-random-secret
FINEDGAR_AUTH_COOKIE_SECURE=0
FINEDGAR_SESSION_DAYS=7
FINEDGAR_EMAIL_TOKEN_HOURS=24
FINEDGAR_PASSWORD_RESET_MINUTES=60
FINEDGAR_PUBLIC_BASE_URL=http://localhost:5173
FINEDGAR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Email delivery for verification and password reset.
# console: print links to backend logs for local/LAN testing.
# smtp: send mail using the SMTP settings below for public deployments.
FINEDGAR_EMAIL_MODE=console
FINEDGAR_EMAIL_FROM=FinEdgar <noreply@example.com>
FINEDGAR_SMTP_HOST=
FINEDGAR_SMTP_PORT=587
FINEDGAR_SMTP_USERNAME=
FINEDGAR_SMTP_PASSWORD=
FINEDGAR_SMTP_STARTTLS=1

# Docker ports.
FINEDGAR_WEB_PORT=8000
FINEDGAR_API_PORT=8000
FINEDGAR_FRONTEND_PORT=5173
OLLAMA_PORT=11434

# Admin/log console.
# The admin console is a separate Compose project powered by Dozzle. It is
# loopback-only by default at http://localhost:8081 and filtered to the main
# FinEdgar Compose project. Keep it loopback-only unless it is protected by
# HTTPS and external auth. Set FINEDGAR_ADMIN_FILTER empty only if you really
# want it to see every Docker container on the host.
FINEDGAR_ADMIN_PORT=8081
FINEDGAR_ADMIN_FILTER=label=com.docker.compose.project=finedgar
FINEDGAR_ADMIN_ENABLE_ACTIONS=false
FINEDGAR_ADMIN_ENABLE_SHELL=false
FINEDGAR_ADMIN_LOG_LEVEL=info
# DOZZLE_VERSION=latest

# Docker platform override. Leave unset to auto-detect.
# FINEDGAR_DOCKER_TARGET=linux-nvidia
# FINEDGAR_DOCKER_TARGET=mac-cpu

# Training-only secrets/settings. Required only for gated HF base models or W&B.
# PYTORCH_IMAGE=pytorch/pytorch:2.11.0-cuda13.0-cudnn9-devel
# HF_TOKEN=
# WANDB_API_KEY=
WANDB_MODE=offline

# Optional observability. Kubernetes observability profile enables these through
# Helm values; local Compose can leave them disabled.
FINEDGAR_OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
OTEL_SERVICE_NAME=finedgar-web
